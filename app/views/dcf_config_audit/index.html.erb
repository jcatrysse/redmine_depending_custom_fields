<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'dcf_config', plugin: 'redmine_depending_custom_fields' %>
<% end %>

<h2><%= l(:label_custom_field_config_audit_global) %></h2>

<% if @events.empty? %>
  <p class="nodata"><%= l(:text_no_audit_events) %></p>
<% else %>
  <table class="list dcf-audit-list">
    <thead>
      <tr>
        <th><%= l(:label_dcf_audit_when) %></th>
        <th><%= l(:label_project) %></th>
        <th><%= l(:label_dcf_audit_actor) %></th>
        <th><%= l(:field_name) %></th>
        <th><%= l(:label_dcf_audit_action) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:label_dcf_audit_summary) %></th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td><%= format_time(event.created_at) %></td>
          <td><%= h(@project_names[event.project_id] || event.project_id) %></td>
          <td><%= h(event.acting_user_name) %></td>
          <td><%= h(event.custom_field_name) %></td>
          <td><%= dcf_audit_action_label(event.action) %></td>
          <td class="<%= dcf_audit_status_class(event.status) %>"><%= dcf_audit_status_label(event.status) %></td>
          <td><%= dcf_audit_summary(event) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <span class="pagination"><%= pagination_links_full @paginator %></span>
<% end %>
