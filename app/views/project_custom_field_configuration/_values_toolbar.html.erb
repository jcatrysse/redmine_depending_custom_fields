<%# Toolbar of the values page. The search in core filter markup
    (groups/index), above 25 values or while q is present: the Clear link
    keeps show_usage and drops q and page; core shows its icon as a sprite on
    6.0 and later and through the class on 5.1. The sort buttons (WP-29) when
    the field has more than one value: they post direction, state_hash and a
    filtering q, never the page. Only a project-only field asks through
    data-confirm with the count of every value; a field shared with other
    projects or global gets the server confirmation panel instead, so no
    field asks twice (UD-23, WP-34). %>
<% show_sort = @values_page.total > 1 %>
<% if @values_page.show_filter? || show_sort %>
  <div class="dcf-values-toolbar">
    <% if @values_page.show_filter? %>
      <%= form_tag(custom_field_configuration_field_path(@project, @field), method: :get, class: 'dcf-values-filter') do %>
        <fieldset><legend><%= l(:label_filter_plural) %></legend>
          <label for="dcf_values_q"><%= l(:label_search) %>:</label>
          <%= text_field_tag 'q', @values_page.query, size: 30, id: 'dcf_values_q', maxlength: 255 %>
          <%= hidden_field_tag 'show_usage', '1', id: nil if @show_usage %>
          <%= submit_tag l(:button_apply), class: 'small', name: nil %>
          <%= link_to(respond_to?(:sprite_icon) ? sprite_icon('reload', l(:button_clear)) : l(:button_clear),
                      clear_path, class: 'icon icon-reload') %>
        </fieldset>
      <% end %>
    <% end %>
    <% if show_sort %>
      <% sort_path = custom_field_configuration_sort_values_path(@project, @field) %>
      <% sort_state = { state_hash: @state_hash }.merge(@values_page.list_state.slice(:q)) %>
      <% sort_data = scope == :project ? { confirm: l(:text_dcf_sort_confirm, count: @values_page.total) } : {} %>
      <%= button_to l(:label_dcf_sort_az), sort_path, method: :patch, params: sort_state.merge(direction: 'asc'),
                    form_class: 'button_to dcf-values-sort', data: sort_data %>
      <%= button_to l(:label_dcf_sort_za), sort_path, method: :patch, params: sort_state.merge(direction: 'desc'),
                    form_class: 'button_to dcf-values-sort', data: sort_data %>
    <% end %>
  </div>
<% end %>
