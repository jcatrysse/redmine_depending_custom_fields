<%# The panel names a dependent field only under the WP-12 rule (SD-16): the
    edited field, an administrator, or a field used in the project and
    visible to the user; the others are only counted. %>
<% affected = impact.affected_child_fields %>
<% named = affected.select { |child| RedmineDependingCustomFields::UsageCalculator.nameable_child?(child, @field, @project, User.current) } %>
<% body = capture do %>
  <p><strong><%= l(:text_confirm_cross_project_change) %></strong></p>
  <ul>
    <li><%= l(:label_usage_this_project) %>: <%= impact.usage_here %></li>
    <li><%= l(:label_usage_other_projects) %>: <%= impact.usage_other %></li>
    <li><%= l(:label_dependency_references) %>: <%= impact.own_dep_refs + impact.parent_key_refs %></li>
    <% if affected.any? %>
      <li><%= l(:label_affected_child_fields) %>: <%= affected.size %><% if named.any? %> (<%= named.map(&:name).join(', ') %>)<% end %></li>
    <% end %>
  </ul>

  <% url, method = dcf_confirm_target(pending_action) %>
  <%= form_tag(url, method: method) do %>
    <% pending_params.each do |k, v| %>
      <% next if k.to_s == 'confirm' %>
      <%# A nested hash (the enumerations batch payload) cannot round-trip
          through a scalar hidden field. No confirmable operation submits one
          today; dropping it makes a future one fail loudly with a validation
          error rather than silently re-submitting a mangled payload. %>
      <% next if v.is_a?(Hash) %>
      <% if v.is_a?(Array) %>
        <% v.each do |item| %><%= hidden_field_tag "#{k}[]", item %><% end %>
      <% else %>
        <%= hidden_field_tag k, v %>
      <% end %>
    <% end %>
    <%= render partial: 'list_state_fields', locals: { state: local_assigns.fetch(:list_state, {}) } %>
    <p>
      <label><%= check_box_tag :confirm, '1', false, required: true %>
        <%= l(:text_dcf_confirm_understand) %></label>
    </p>
    <%= submit_tag l(:button_apply) %>
  <% end %>
<% end %>
<div class="dcf-confirm-panel"><%= dcf_flash_box(:warning, body) %></div>
