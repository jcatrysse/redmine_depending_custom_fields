<%# WP-10: same type and family, without the field and its descendants (the current parent stays); one topology load per render, also read by the editor's required warning (WP-25). -%>
<% dcf_index = @custom_field.new_record? ? nil : RedmineDependingCustomFields::FieldIndex.load %>
<% dcf_editor = RedmineDependingCustomFields::DependencyEditorConfig.for_admin(@custom_field, self, index: dcf_index) %>
<% unless @custom_field.new_record? %>
<p>
  <label><%= l(:field_possible_values) %></label>
  <% if respond_to?(:sprite_icon) %>
    <%= link_to sprite_icon('edit', l(:button_edit)), custom_field_enumerations_path(@custom_field), :class => 'icon icon-edit' %>
  <% else %>
    <%= link_to l(:button_edit), custom_field_enumerations_path(@custom_field), :class => 'icon icon-edit' %>
  <% end %>
</p>
  <%# WP-25 (UX-11): rendered whenever core offers the select, hidden while a parent is set; the editor toggles it live. -%>
  <% if @custom_field.enumerations.active.any? %>
    <p data-dcf-default-value-row<%= ' class="dcf-hidden"'.html_safe if dcf_editor.parent %>><%= f.select :default_value, @custom_field.enumerations.active.map { |v| [v.name, v.id.to_s] }, include_blank: true %></p>
  <% end %>
<% end %>
<p><%= f.text_field :url_pattern, :size => 50, :label => :label_link_values_to %></p>
<p>
  <%= f.select :parent_custom_field_id,
               RedmineDependingCustomFields::DependencyRules.parent_candidates(@custom_field, index: dcf_index)
                                                            .map { |cf| [cf.name, cf.id.to_s] },
               {include_blank: true},
               label: :field_parent_custom_field_id %>
</p>
<% dcf_cycle_ids = dcf_index ? RedmineDependingCustomFields::DependencyRules.cycle_member_ids(@custom_field, index: dcf_index) : [] %>
<% if dcf_cycle_ids.any? %>
  <% dcf_cycle_names = CustomField.where(id: dcf_cycle_ids).pluck(:id, :name).to_h %>
  <% dcf_cycle_warning = l(:warning_dcf_parent_cycle, fields: dcf_cycle_ids.map { |id| dcf_cycle_names[id] }.compact.join(', ')) %>
  <p class="icon icon-warning"><%= respond_to?(:sprite_icon) ? sprite_icon('warning', dcf_cycle_warning) : dcf_cycle_warning %></p>
<% end %>
<p><%= f.check_box :hide_when_disabled, label: :field_hide_when_disabled %></p>
<p><%= edit_tag_style_tag f %></p>
<%= render 'depending_custom_fields/dependency_editor', editor: dcf_editor %>
