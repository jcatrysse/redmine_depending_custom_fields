<%# frozen_string_literal: true %>
<%# One wizard entry per root (ContextMenuHook): listed only when the levels hold a field the gate user (local user, default User.current) may edit on every selected issue (ParentDetector.wizard_levels). %>
<%# WP-36 (UD-13 changed by the owner): the entry only, with the URL of the wizard body; context_menu_wizard.js fetches the form (_context_menu_wizard_form) from ContextMenuWizardController#show when the wizard opens. %>
<% issue_ids = Array(issues).map(&:id) %>
<% fields_hierarchy = RedmineDependingCustomFields::ParentDetector.wizard_levels(parent_field, issues, graph: graph, user: local_assigns.fetch(:user, User.current)) %>
<% if fields_hierarchy.any? %>
<li class="folder cf-parent"
    data-parent-id="<%= parent_field.id %>"
    data-issue-ids="<%= issue_ids.join(',') %>"
    data-wizard-url="<%= depending_custom_fields_wizard_path %>">
  <a href="#" class="submenu"><%= h(parent_field.name) %></a>
</li>
<% end %>
